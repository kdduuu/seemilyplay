<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>seemilyplay</title>

    <link rel="stylesheet"
          href="/css/home.css">

</head>

<body>


    <!-- ===================================== -->
    <!-- SCANLINES -->
    <!-- ===================================== -->

    <div class="scanlines"></div>


    <!-- ===================================== -->
    <!-- JANELA -->
    <!-- ===================================== -->

    <div class="browser-window">


        <!-- ===================================== -->
        <!-- TOPO -->
        <!-- ===================================== -->

        <div class="browser-top">


            <div class="window-buttons">

                <span></span>
                <span></span>
                <span></span>

            </div>


            <div class="window-title">

                emily navigator

            </div>

        </div>


        <!-- ===================================== -->
        <!-- MENU -->
        <!-- ===================================== -->

        <div class="menu-bar">

            <span data-message="Browsing local files...">File</span>

            <span data-message="Nothing to edit here.">Edit</span>

            <span data-message="Viewing cached content.">View</span>

            <span data-message="4 saved items found.">Favorites</span>

            <span data-message="No help needed.">Help</span>

        </div>


        <!-- ===================================== -->
        <!-- URL -->
        <!-- ===================================== -->

        <div class="url-bar">

            <span>URL:</span>

            <input
                id="browserUrl" 
                type="text"
                value="https://seemilyplay.net"
                readonly>

        </div>


        <!-- ===================================== -->
        <!-- FRASE -->
        <!-- ===================================== -->

        <div class="top-quote" id="topQuote">

            now we are all just here to see Emily play

            <span class="cursor">|</span>

        </div>


        <!-- ===================================== -->
        <!-- CONTEÚDO -->
        <!-- ===================================== -->

        <div class="main-content">


            <!-- ===================================== -->
            <!-- ESQUERDA -->
            <!-- ===================================== -->

            <div class="left-side">


                <!-- ===================================== -->
                <!-- GALERIA -->
                <!-- ===================================== -->

                <div class="window-box">

                    <div class="box-title">

                        webcam archive

                    </div>


                    <div class="gallery">


                        <!-- FOTO -->

                        <div class="photo-card">

                            <div class="photo-wrapper">

                                <img src="/photos/photo1.jpeg">

                                <div class="timestamp" data-time="02:14AM">

                                    02:14AM

                                </div>

                            </div>

                        </div>



                        <!-- FOTO -->

                        <div class="photo-card">

                            <div class="photo-wrapper">

                                <img src="/photos/photo2.jpeg">

                                <div class="timestamp" data-time="02:32AM">

                                    02:32AM

                                </div>

                            </div>

                        </div>


                    </div>

                </div>



                <!-- ===================================== -->
                <!-- CHAT -->
                <!-- ===================================== -->

                <div class="window-box">

                    <div class="box-title">

                        archived chatlogs

                    </div>


                    <div class="chat-area">


                        <div class="messages fake-chat">


                            <!-- MENSAGEM -->

                            <div class="message user">

                                <small>[23:02PM]</small>

                                <span>kadu:</span>

                                <p>

                                    esqueceu o notebook ligado

                                </p>

                            </div>



                            <!-- MENSAGEM -->

                            <div class="message emily">

                                <small>[23:09PM]</small>

                                <span>emily:</span>

                                <p>

                                    tava ouvindo musica 😞

                                </p>

                            </div>



                            <!-- MENSAGEM -->

                            <div class="message user">

                                <small>[02:19AM]</small>

                                <span>kadu:</span>

                                <p>

                                    por 3 horas?

                                </p>

                            </div>



                            <!-- MENSAGEM -->

                            <div class="message emily">

                                <small>[02:30AM]</small>

                                <span>emily:</span>

                                <p>

                                    eu dormi...

                                </p>

                            </div>



                            <!-- SISTEMA -->

                            <div class="message system">

                                <p>

                                    emily is listening to:
                                    "Dagger"

                                </p>

                            </div>


                        </div>


                    </div>

                </div>


            </div>


            <!-- ===================================== -->
            <!-- DIREITA -->
            <!-- ===================================== -->

            <div class="right-side">


            <!-- ===================================== -->
            <!-- MÚSICA -->
            <!-- ===================================== -->

            <div class="window-box">

                <div class="box-title">

                    now playing

                </div>


            <div class="music-box">

            <p>

                Slowdive

            </p>

            <p class="song-name">

                Dagger

            </p>

            <audio id="site-audio" loop preload="metadata">

                <source src="/music/song.mp3" type="audio/mpeg">

            </audio>

            <div class="retro-audio-player">

                <button id="audio-toggle" class="audio-toggle" type="button">

                    [ play ]

                </button>

            <div class="audio-bar" id="audio-bar">

                <div class="audio-progress" id="audio-progress"></div>

            </div>

            <span id="audio-time" class="audio-time">

                0:00 / 0:00

            </span>

            </div>

        </div>

        </div>



                <!-- ===================================== -->
                <!-- STATUS -->
                <!-- ===================================== -->

                <div class="window-box">

                    <div class="box-title">

                        user status

                    </div>

                    <div class="status-box">

                        <p>last online: 2:37AM</p>

                        <p>connection: stable</p>

                        <p>status: probably asleep</p>

                        <p>camera feed archived</p>

                        <p>cached locally</p>

                        <div class="owner-tag" id="scott-trigger">

                            SCOTT

                        </div>

                    </div>



                </div>



                <!-- ===================================== -->
                <!-- LINKS -->
                <!-- ===================================== -->

                <div class="window-box">

                    <div class="box-title">

                        saved pages

                    </div>

                    <div class="links-box">

                        <a href="#" data-url="old-photos">
                            old photos
                        </a>

                        <a href="#" data-url="a7x-playlist">
                            a7x playlist
                        </a>

                        <a href="#" data-url="camera-roll">
                            camera roll
                        </a>

                        <a href="#" data-url="last-seen">
                            last seen
                        </a>

                    </div>

                </div>



                <!-- ===================================== -->
                <!-- UPDATE -->
                <!-- ===================================== -->

                <div class="window-box">

                    <div class="box-title">

                        ARCHIVE INFO

                    </div>

                    <div class="status-box">

                        <p>build: 1.0</p>

                        <p>resolution: 1280x720</p>

                        <p>last backup: 12/05/2005</p>

                    </div>

                </div>


            </div>


        </div>


    </div>

