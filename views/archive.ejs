<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>archive | seemilyplay</title>

    <link rel="stylesheet" href="/css/archive.css">
    <link rel="stylesheet" href="/css/home.css">

</head>

<body>


    <!-- ===================================== -->
    <!-- SCANLINES -->
    <!-- ===================================== -->

    <div class="scanlines"></div>


    <!-- ===================================== -->
    <!-- JANELA -->
    <!-- ===================================== -->

    <div class="browser-window">


        <!-- ===================================== -->
        <!-- TOPO -->
        <!-- ===================================== -->

        <div class="browser-top">

            <div class="window-buttons">

                <span></span>
                <span></span>
                <span></span>

            </div>

            <div class="window-title">

                emily navigator

            </div>

        </div>


        <!-- ===================================== -->
        <!-- MENU -->
        <!-- ===================================== -->

        <div class="menu-bar">

            <span>File</span>
            <span>Edit</span>
            <span>View</span>
            <span>Favorites</span>
            <span>Help</span>

        </div>


        <!-- ===================================== -->
        <!-- URL -->
        <!-- ===================================== -->

        <div class="url-bar">

            <span>URL:</span>

            <input type="text"
                   value="https://seemilyplay.net/archive"
                   readonly>

        </div>


        <!-- ===================================== -->
        <!-- FRASE -->
        <!-- ===================================== -->

        <div class="top-quote">

            there's always one more archive.

        </div>


        <!-- ===================================== -->
        <!-- CONTEÚDO -->
        <!-- ===================================== -->

        <div class="main-content">


        <!-- ===================================== -->
        <!-- ESQUERDA -->
        <!-- ===================================== -->

        <div class="left-side">


        <!-- ===================================== -->
        <!-- ARCHIVE INFORMATION -->
        <!-- ===================================== -->

        <div class="window-box">

            <div class="box-title">

                archive information

            </div>

            <div class="status-box">

                <p>archive id: #003</p>

                <p>status: unlocked</p>

                <p>created: 12/06/2026</p>

                <p>visibility: hidden</p>

            </div>

        </div>


        <!-- ===================================== -->
        <!-- SYSTEM LOG -->
        <!-- ===================================== -->

        <div class="window-box">

            <div class="box-title">

                system log

            </div>

            <div class="status-box"
                 id="system-log">

                <p>> archive detected...</p>

                <p>> verifying integrity...</p>

                <p>> archive successfully unlocked.</p>

                <p>> awaiting user input.</p>

            </div>

        </div>


    </div>


    <!-- ===================================== -->
    <!-- DIREITA -->
    <!-- ===================================== -->

    <div class="right-side">


        <!-- ===================================== -->
        <!-- NOTES -->
        <!-- ===================================== -->

        <div class="window-box">

            <div class="box-title">

                notes

            </div>

            <div class="status-box">

                <p>This archive wasn't part</p>

                <p>of the original collection.</p>

                <br>

                <p>I think it was waiting</p>

                <p>for you.</p>

            </div>

        </div>


        <!-- ===================================== -->
        <!-- ACCESS -->
        <!-- ===================================== -->

        <div class="window-box">

            <div class="box-title">

                access

            </div>

            <div class="status-box">

                <button id="openArchive">

                    > Open Archive

                </button>

            </div>

        </div>


    </div>


</div>


<script src="/js/archive.js"></script>

</body>

</html>